rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Config: public read, no direct write
    match /reunion_config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Family members: public read, no direct write (admin API only)
    match /family_members/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Schedule: public read, no direct write (admin API only)
    match /schedule_items/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Gallery: only approved photos readable, uploads must start unapproved (moderated)
    match /gallery_photos/{doc} {
      allow read: if resource.data.approved == true;
      allow create: if request.resource.data.approved == false;
      allow update, delete: if false;
    }

    // RSVPs: PII — never public; form submission (create) still works
    match /rsvps/{doc} {
      allow read: if false;
      allow create: if true;
      allow update, delete: if false;
    }

    // Chat: public read & create, no update/delete
    match /chat_messages/{doc} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Trivia
    match /trivia_questions/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /trivia_scores/{doc} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Contributions: pending PII — no client access, all writes via API (server-side)
    match /contributions/{doc} {
      allow read: if false;
      allow create: if false;
      allow update, delete: if false;
    }
  }
}
